# ============================================================
# VaultPay Financial-Core — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/vaultpay

# JWT — Use long random strings (e.g., openssl rand -hex 64)
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhook HMAC Signing Secret
WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ── Stripe Payment Integration ───────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Get this from https://dashboard.stripe.com/webhooks
# Run: stripe listen --forward-to localhost:5000/api/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# CORS — Frontend origin
CLIENT_ORIGIN=http://localhost:5173
